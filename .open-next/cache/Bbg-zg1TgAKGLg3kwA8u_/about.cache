{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"},"segmentPaths":["/_tree","/_full","/about/__PAGE__","/about","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"bricolage_grotesque_e343a7e-module__WPGFWa__variable plus_jakarta_sans_413f2de7-module__hLvCDG__variable geist_mono_8d43a2aa-module__8Li5zG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/017d9bea37084d9b-s.p.41rroleoq1br7.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0w5z4e7s8jfe5.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/fba5a26ea33df6a3-s.p.18rizl4rsrl42.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0mjm8rpxa1w1n.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/27sconea632l-.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/13o17l5vs-wsr.js\"/><script src=\"/_next/static/chunks/2kqrbujyxigm8.js\" async=\"\"></script><script src=\"/_next/static/chunks/2ncdmtj91g36a.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mfjqidm5qp0a.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-35tulveot0_lz.js\" async=\"\"></script><script src=\"/_next/static/chunks/1el5-48au3iai.js\" async=\"\"></script><script src=\"/_next/static/chunks/14mrh2-p_w84d.js\" async=\"\"></script><script src=\"/_next/static/chunks/0xczntvxk6olu.js\" async=\"\"></script><script src=\"/_next/static/chunks/1e92byvhu38v9.js\" async=\"\"></script><script src=\"/_next/static/chunks/0znalxg1edf-w.js\" async=\"\"></script><script src=\"/_next/static/chunks/2rc8erc9vxtob.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-FC1Y3Z3VDH\" as=\"script\"/><meta name=\"next-size-adjust\" content=\"\"/><title>About — The People Behind Mylobstr | Mylobstr</title><meta name=\"description\" content=\"Mylobstr is Likki — a developer, a mom, and a small business believer building affordable websites for Albany, NY businesses.\"/><meta name=\"keywords\" content=\"local business website design,small business website,restaurant website design,pet clinic website,salon website design,barbershop website,plumber website,gym website design,web design agency Albany NY,affordable web design,website with online booking\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta property=\"og:title\" content=\"Mylobstr — Web Design for Local Businesses\"/><meta property=\"og:description\" content=\"Beautiful, animated websites for local businesses. Pet clinics, restaurants, salons, barbershops, plumbers, and gyms. Launch in 48 hours starting at $100.\"/><meta property=\"og:url\" content=\"https://mylobstr.com\"/><meta property=\"og:site_name\" content=\"Mylobstr\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Mylobstr — Web Design for Local Businesses\"/><meta name=\"twitter:description\" content=\"Beautiful websites for local businesses. Launch in 48 hours starting at $100.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><div class=\"min-h-screen flex items-center justify-center bg-white\"><div class=\"flex flex-col items-center gap-4\"><div class=\"w-10 h-10 rounded-full border-2 border-gray-200 border-t-gray-900 animate-spin\"></div><p class=\"text-sm text-gray-400 font-medium\">Loading…</p></div></div><!--/$--><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script src=\"/_next/static/chunks/13o17l5vs-wsr.js\" id=\"_R_\" async=\"\"></script><div hidden id=\"S:0\"><div class=\"min-h-screen bg-white\"><header class=\"fixed top-0 left-0 right-0 z-50\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex items-center justify-between py-4\"><a href=\"/\" class=\"flex items-center gap-2.5 group shrink-0 bg-gray-900 border-2 border-gray-900 rounded-full px-3 py-1.5 hover:bg-gray-800 transition-colors\"><div class=\"w-7 h-7 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-[14px] h-[14px] text-white\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><div class=\"leading-none\"><span class=\"text-[1rem] font-black tracking-tight text-white\">mylobstr</span><span class=\"text-[1rem] font-black tracking-tight text-blue-400\">.</span><span class=\"text-[1rem] font-black tracking-tight text-white\">com</span></div></a><ul class=\"relative hidden md:flex w-fit rounded-full border-2 border-gray-900 bg-white p-1\"><li class=\"relative z-10 block cursor-pointer\"><a href=\"/our-work\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">Our Work</a></li><li class=\"relative z-10 block cursor-pointer\"><a href=\"/pricing\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">Pricing</a></li><li class=\"relative z-10 block cursor-pointer\"><a href=\"/about\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">About</a></li><li class=\"relative z-10 block cursor-pointer\"><a href=\"/faq\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">FAQ</a></li><li class=\"relative z-10 block cursor-pointer\"><a href=\"/contact\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">Contact</a></li><li class=\"absolute z-0 top-1 bottom-1 rounded-full bg-gray-200\"></li></ul><div class=\"hidden md:flex items-center gap-3 shrink-0\"><a href=\"/contact\" class=\"inline-flex items-center px-4 py-2 bg-white hover:bg-gray-100 text-gray-900 text-sm font-semibold rounded-full transition-all hover:scale-105 shadow-sm border border-gray-200\">Get a Free Quote</a></div><button class=\"md:hidden w-9 h-9 flex items-center justify-center rounded-lg bg-white/20 hover:bg-white/30 backdrop-blur-sm transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu w-4 h-4 text-white\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><section class=\"bg-gray-950 pt-32 pb-16 text-center px-4\"><span class=\"inline-block text-xs font-bold uppercase tracking-widest text-blue-400 mb-3\">Who We Are</span><h1 class=\"text-4xl lg:text-5xl font-black text-white mb-4 leading-tight\">Not a big agency.<br/><span class=\"bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent\">A real person who gives a damn.</span></h1><p class=\"text-gray-400 max-w-xl mx-auto text-lg\">Built in Albany, for Albany. By a developer, a mom, and a small business believer.</p></section><section id=\"about\" class=\"py-24 lg:py-32 bg-white\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24\"><div class=\"grid lg:grid-cols-2 gap-12 items-center\"><div class=\"space-y-6\" style=\"opacity:0;transform:translateX(-30px)\"><p class=\"text-lg text-gray-500 leading-relaxed\">Mylobstr is Likki — a developer, a mom, and a small business believer — who got tired of watching great Albany businesses lose customers to competitors with better-looking websites. A brilliant local restaurant shouldn&#x27;t lose a booking because their site looks like 2008.</p><p class=\"text-lg text-gray-500 leading-relaxed\">So she built a no-fluff, affordable web studio specifically for the Albany metro.<strong class=\"text-gray-800\"> For the community, by the community.</strong></p><div class=\"flex items-start gap-4 p-5 bg-gray-950 rounded-2xl text-white\"><span class=\"text-3xl shrink-0\">🐾</span><div><p class=\"font-bold text-sm mb-1\">How Mylobstr actually started:</p><p class=\"text-sm text-gray-400 leading-relaxed\">2am. Newborn in one arm. Laptop in the other. Luna asleep on Likki&#x27;s feet. The Wi-Fi was slow. The idea was fast. She thought — <em>&quot;if I can build something beautiful under these conditions, I can build it for anyone.&quot;</em>That&#x27;s still the standard.</p></div></div></div><div class=\"relative\" style=\"opacity:0;transform:translateX(30px)\"><div class=\"relative rounded-3xl overflow-hidden shadow-2xl h-80 lg:h-96\"><img alt=\"Team working together\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 50vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1522071820081-009f0129c71c%3Fw%3D800%26q%3D85&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent\"></div><div class=\"absolute bottom-5 left-5 right-5 text-white\"><p class=\"font-bold text-lg\">Albany, NY</p><p class=\"text-white/70 text-sm\">Building for our community since 2023</p></div></div><div class=\"absolute -top-4 -right-4 bg-white rounded-2xl shadow-xl p-4 border border-gray-100\"><p class=\"text-2xl font-black text-gray-900\">50+</p><p class=\"text-xs text-gray-500 font-medium\">Albany businesses<br/>with a web presence</p></div></div></div><div><div class=\"text-center mb-12\" style=\"opacity:0;transform:translateY(20px)\"><h3 class=\"text-3xl font-black text-gray-900 mb-2\">The People Behind the Pixels</h3><p class=\"text-gray-500\">We&#x27;re real humans. Possibly too passionate about small business websites.</p></div><div class=\"grid md:grid-cols-3 gap-8\"><div class=\"group text-center\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative inline-block mb-4\"><div class=\"w-24 h-24 rounded-3xl overflow-hidden ring-4 ring-white shadow-xl mx-auto group-hover:ring-blue-100 transition-all\"><img alt=\"Likki.\" loading=\"lazy\" width=\"96\" height=\"96\" decoding=\"async\" data-nimg=\"1\" class=\"object-cover w-full h-full\" style=\"color:transparent\" src=\"/team/likki.svg\"/></div><span class=\"absolute -bottom-2 -right-2 text-xl\">💻</span></div><h4 class=\"font-black text-gray-900 text-base\">Likki.</h4><p class=\"text-blue-600 text-xs font-semibold mb-2\">Founder · Developer · Analyst · Sleep-Deprived Visionary</p><p class=\"text-sm text-gray-500 leading-relaxed mb-3\">Likki built Mylobstr at 2am during a phase she calls &#x27;hyperfocus season.&#x27; She talks to her code. The code talks back. She analyzes everything — your website traffic, your bounce rate, why the checkout button is the wrong shade of blue, and whether her son&#x27;s nap schedule can fit around a client call. Spoiler: it cannot. But the website always ships.</p><div class=\"inline-block text-xs font-bold px-3 py-1 bg-gray-100 rounded-full text-gray-600\">Secret talent: <!-- -->Cries at good UX. Audits competitor websites for fun at midnight.</div></div><div class=\"group text-center\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative inline-block mb-4\"><div class=\"w-24 h-24 rounded-3xl overflow-hidden ring-4 ring-white shadow-xl mx-auto group-hover:ring-blue-100 transition-all\"><img alt=\"Likki&#x27;s Son.\" loading=\"lazy\" width=\"96\" height=\"96\" decoding=\"async\" data-nimg=\"1\" class=\"object-cover w-full h-full\" style=\"color:transparent\" src=\"/team/son.svg\"/></div><span class=\"absolute -bottom-2 -right-2 text-xl\">🍼</span></div><h4 class=\"font-black text-gray-900 text-base\">Likki&#x27;s Son.</h4><p class=\"text-blue-600 text-xs font-semibold mb-2\">Chief Motivation Officer · Diaper Department Head</p><p class=\"text-sm text-gray-500 leading-relaxed mb-3\">He doesn&#x27;t know what a website is. He doesn&#x27;t know what SEO means. He doesn&#x27;t care. But every time Likki thinks about quitting, he looks up and grins — and somehow that&#x27;s the most compelling business case she&#x27;s ever seen. He is the reason every small business deserves a fighting chance online. He is also the reason she bought stock in wet wipes.</p><div class=\"inline-block text-xs font-bold px-3 py-1 bg-gray-100 rounded-full text-gray-600\">Secret talent: <!-- -->Closed two client deals just by being adorable on a video call.</div></div><div class=\"group text-center\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative inline-block mb-4\"><div class=\"w-24 h-24 rounded-3xl overflow-hidden ring-4 ring-white shadow-xl mx-auto group-hover:ring-blue-100 transition-all\"><img alt=\"Luna.\" loading=\"lazy\" width=\"96\" height=\"96\" decoding=\"async\" data-nimg=\"1\" class=\"object-cover w-full h-full\" style=\"color:transparent\" src=\"/team/luna.svg\"/></div><span class=\"absolute -bottom-2 -right-2 text-xl\">🐾</span></div><h4 class=\"font-black text-gray-900 text-base\">Luna.</h4><p class=\"text-blue-600 text-xs font-semibold mb-2\">Likki&#x27;s Dog · Head of Moral Support · Vibes Manager</p><p class=\"text-sm text-gray-500 leading-relaxed mb-3\">Luna has never once cared about load times, responsive design, or conversion rates. And honestly? That&#x27;s her power. She parks herself under Likki&#x27;s desk, snores through strategy calls, and reminds everyone in the room that sometimes the best thing you can do for your business is take a walk. She is also personally responsible for at least three &#x27;sorry, give me a second&#x27; moments on client calls.</p><div class=\"inline-block text-xs font-bold px-3 py-1 bg-gray-100 rounded-full text-gray-600\">Secret talent: <!-- -->Has never missed a deadline. Mostly because she sets none.</div></div></div></div><div class=\"rounded-3xl bg-gray-950 text-white p-8 lg:p-12\"><div class=\"text-center mb-10\" style=\"opacity:0;transform:translateY(20px)\"><h3 class=\"text-3xl font-black mb-2\">What We Actually Care About</h3><p class=\"text-gray-400\">(Besides really good coffee and not terrible code reviews)</p></div><div class=\"grid sm:grid-cols-2 gap-6\"><div class=\"flex gap-4 p-5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors\" style=\"opacity:0;transform:translateY(20px)\"><span class=\"text-2xl shrink-0\">🤝</span><div><h4 class=\"font-bold text-white mb-1\">We&#x27;re your neighbors</h4><p class=\"text-sm text-gray-400 leading-relaxed\">We shop at the same Albany spots, eat at the same restaurants, and genuinely want them to thrive.</p></div></div><div class=\"flex gap-4 p-5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors\" style=\"opacity:0;transform:translateY(20px)\"><span class=\"text-2xl shrink-0\">💸</span><div><h4 class=\"font-bold text-white mb-1\">Fair pricing always</h4><p class=\"text-sm text-gray-400 leading-relaxed\">Small business owners shouldn&#x27;t have to choose between a website and keeping the lights on. We priced it that way.</p></div></div><div class=\"flex gap-4 p-5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors\" style=\"opacity:0;transform:translateY(20px)\"><span class=\"text-2xl shrink-0\">📞</span><div><h4 class=\"font-bold text-white mb-1\">24/7 real humans</h4><p class=\"text-sm text-gray-400 leading-relaxed\">No bots, no call centers. If you text us at midnight because the site looks weird — yes, someone actually reads that.</p></div></div><div class=\"flex gap-4 p-5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors\" style=\"opacity:0;transform:translateY(20px)\"><span class=\"text-2xl shrink-0\">❤️</span><div><h4 class=\"font-bold text-white mb-1\">Emotionally invested</h4><p class=\"text-sm text-gray-400 leading-relaxed\">When your bookings drop, we lose sleep. When you land your biggest client yet, we celebrate. It&#x27;s personal.</p></div></div></div></div></div></section><footer class=\"relative overflow-hidden bg-gray-950 text-white\"><div class=\"absolute top-0 left-0 w-96 h-96 bg-blue-600/5 rounded-full blur-3xl pointer-events-none\"></div><div class=\"absolute bottom-0 right-0 w-72 h-72 bg-indigo-600/5 rounded-full blur-3xl pointer-events-none\"></div><div class=\"border-b border-white/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\"><div class=\"flex flex-col lg:flex-row items-center justify-between gap-6\"><div class=\"text-center lg:text-left\"><h3 class=\"text-2xl font-black mb-1\">Let&#x27;s build something great together.<!-- --> <span class=\"bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent\">Right here in Albany.</span></h3><p class=\"text-white/50 text-sm\">No fancy agency. Just neighbors who know how to build a great website.</p></div><div class=\"flex flex-wrap gap-3 justify-center shrink-0\"><a href=\"/contact\" class=\"px-6 py-3 bg-white text-gray-900 font-bold rounded-xl text-sm hover:bg-gray-100 transition-colors hover:scale-105 transform\">Get a Free Quote →</a><a href=\"mailto:info@mylobstr.com\" class=\"px-6 py-3 bg-white/10 hover:bg-white/20 rounded-xl font-bold text-sm transition-colors flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail w-4 h-4\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg>info@mylobstr.com</a></div></div></div></div><div class=\"relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16\"><div class=\"grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10\"><div class=\"col-span-2 lg:col-span-1 space-y-4\"><a href=\"/\" class=\"flex items-center gap-2\"><div class=\"w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-[18px] h-[18px] text-white\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><span class=\"font-black text-base text-white\">mylobstr<span class=\"text-blue-400\">.</span>com</span></a><p class=\"text-sm text-white/50 leading-relaxed\">Albany Metro&#x27;s neighborhood web studio. For the community, by the community.</p><div class=\"flex items-center gap-2 text-xs font-medium text-white/40\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-3.5 h-3.5 text-blue-400\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Albany, NY Metro Area</div><div class=\"flex items-center gap-1.5 text-xs font-semibold text-emerald-400\"><span class=\"w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse\"></span>Always here — 24/7</div></div><div class=\"space-y-3\"><h4 class=\"text-xs font-black text-white/70 uppercase tracking-wider\">Our Work</h4><ul class=\"space-y-2\"><li><a href=\"/projects/pet\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Happy Paws Vet</a></li><li><a href=\"/projects/restaurant\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Trattoria Albany</a></li><li><a href=\"/projects/salon\" class=\"text-sm text-white/40 ho