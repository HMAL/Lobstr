4a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-3 h-3 fill-amber-400 text-amber-400\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg></div><p class=\"text-xs text-gray-500 leading-relaxed\"><span class=\"text-gray-800 font-semibold\">&quot;Calls doubled in 3 weeks.&quot;</span> <!-- -->— Tony M., Albany Pro Plumbing</p></div></div></div><div class=\"hidden md:flex w-1/2 relative items-center justify-center\"><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><div class=\"w-full h-full flex items-center justify-center bg-white\"><div class=\"w-10 h-10 rounded-full border-2 border-gray-200 border-t-gray-800 animate-spin\"></div></div><!--/$--></div></div><div class=\"absolute bottom-0 left-0 right-0 h-px bg-gray-100 pointer-events-none\"></div></div><section class=\"py-24 lg:py-32 bg-white bg-dot-grid relative overflow-hidden\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\" style=\"opacity:0;filter:blur(8px);transform:translateY(40px)\"><span class=\"inline-block text-xs font-bold uppercase tracking-widest text-blue-600 mb-3\">The Process</span><h2 class=\"text-4xl lg:text-5xl font-black text-gray-900 mb-4 leading-tight\">From idea to live site<br/><span class=\"bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent\">in 4 simple steps.</span></h2><p class=\"text-lg text-gray-500 max-w-xl mx-auto\">Most clients are live before the weekend. Here&#x27;s exactly what happens after you reach out.</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-6\"><div class=\"relative bg-white rounded-3xl p-7 border-2 border-gray-100 hover:border-gray-200 hover:shadow-lg transition-all duration-300\" style=\"opacity:0;filter:blur(4px);transform:translateY(40px) scale(0.96)\"><div class=\"hidden lg:block absolute top-10 -right-3 w-6 h-px bg-gray-200 z-10\"></div><div class=\"w-12 h-12 rounded-2xl flex items-center justify-center mb-5 bg-violet-100 text-violet-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-list w-5 h-5\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"M12 11h4\"></path><path d=\"M12 16h4\"></path><path d=\"M8 11h.01\"></path><path d=\"M8 16h.01\"></path></svg></div><span class=\"text-xs font-black text-gray-300 tracking-widest mb-2 block\">01</span><h3 class=\"font-black text-gray-900 text-base mb-2 leading-snug\">Tell us about your business</h3><p class=\"text-sm text-gray-500 leading-relaxed\">Fill out our 10-minute brief — your services, style, and what you want customers to do when they land on your site.</p></div><div class=\"relative bg-white rounded-3xl p-7 border-2 border-gray-100 hover:border-gray-200 hover:shadow-lg transition-all duration-300\" style=\"opacity:0;filter:blur(4px);transform:translateY(40px) scale(0.96)\"><div class=\"hidden lg:block absolute top-10 -right-3 w-6 h-px bg-gray-200 z-10\"></div><div class=\"w-12 h-12 rounded-2xl flex items-center justify-center mb-5 bg-blue-100 text-blue-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hammer w-5 h-5\" aria-hidden=\"true\"><path d=\"m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9\"></path><path d=\"m18 15 4-4\"></path><path d=\"m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5\"></path></svg></div><span class=\"text-xs font-black text-gray-300 tracking-widest mb-2 block\">02</span><h3 class=\"font-black text-gray-900 text-base mb-2 leading-snug\">We design &amp; build</h3><p class=\"text-sm text-gray-500 leading-relaxed\">Your custom site is built from scratch — no templates. You get a private preview link within 48 hours of us starting.</p></div><div class=\"relative bg-white rounded-3xl p-7 border-2 border-gray-100 hover:border-gray-200 hover:shadow-lg transition-all duration-300\" style=\"opacity:0;filter:blur(4px);transform:translateY(40px) scale(0.96)\"><div class=\"hidden lg:block absolute top-10 -right-3 w-6 h-px bg-gray-200 z-10\"></div><div class=\"w-12 h-12 rounded-2xl flex items-center justify-center mb-5 bg-amber-100 text-amber-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye w-5 h-5\" aria-hidden=\"true\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></div><span class=\"text-xs font-black text-gray-300 tracking-widest mb-2 block\">03</span><h3 class=\"font-black text-gray-900 text-base mb-2 leading-snug\">You review &amp; approve</h3><p class=\"text-sm text-gray-500 leading-relaxed\">Click through your site on the preview link. Two full rounds of revisions included. We don&#x27;t go live until you say the word.</p></div><div class=\"relative bg-white rounded-3xl p-7 border-2 border-gray-100 hover:border-gray-200 hover:shadow-lg transition-all duration-300\" style=\"opacity:0;filter:blur(4px);transform:translateY(40px) scale(0.96)\"><div class=\"w-12 h-12 rounded-2xl flex items-center justify-center mb-5 bg-emerald-100 text-emerald-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-rocket w-5 h-5\" aria-hidden=\"true\"><path d=\"M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5\"></path><path d=\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09\"></path><path d=\"M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z\"></path><path d=\"M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05\"></path></svg></div><span class=\"text-xs font-black text-gray-300 tracking-widest mb-2 block\">04</span><h3 class=\"font-black text-gray-900 text-base mb-2 leading-snug\">You go live</h3><p class=\"text-sm text-gray-500 leading-relaxed\">We point your domain, flip the switch, your site is live. 24/7 monitoring starts immediately. You&#x27;re on the map.</p></div></div><div class=\"text-center mt-10\" style=\"opacity:0\"><a href=\"/contact\" class=\"shimmer inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white font-bold rounded-full text-sm hover:bg-gray-700 transition-all hover:scale-105\">Start the process — free mockup first</a></div></div></section><section id=\"services\" class=\"py-24 lg:py-32 bg-white\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\" style=\"opacity:0;filter:blur(8px);transform:translateY(40px)\"><span class=\"inline-block text-xs font-bold uppercase tracking-widest text-blue-600 mb-3\">Who We Serve</span><h2 class=\"text-4xl lg:text-5xl font-black text-gray-900 mb-4 leading-tight\">Every Albany Business<br/><span class=\"bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent\">Deserves a Great Website</span></h2><p class=\"text-lg text-gray-500 max-w-2xl mx-auto mb-3\">From mom-and-pop shops to growing local businesses — if you&#x27;re in the Albany metro, we&#x27;re your neighbors and your web team.</p><p class=\"text-sm text-gray-400\">Tap any card to see what&#x27;s included for your business type.</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"cursor-pointer\" style=\"perspective:1200px;height:360px;opacity:0;filter:blur(4px);transform:translateY(40px) scale(0.96)\"><div style=\"transform-style:preserve-3d;position:relative;width:100%;height:100%\"><div style=\"backface-visibility:hidden;position:absolute;inset:0\" class=\"rounded-2xl overflow-hidden border border-gray-100 bg-white shadow-sm group\"><div class=\"relative h-44 overflow-hidden\"><img alt=\"Restaurants &amp; Cafés\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1517248135467-4c7edcad34c4%3Fw%3D600%26q%3D80&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1517248135467-4c7edcad34c4%3Fw%3D600%26q%3D80&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1517248135467-4c7edcad34c4%3Fw%3D600%26q%3D80&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1517248135467-4c7edcad34c4%3Fw%3D600%26q%3D80&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2