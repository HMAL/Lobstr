\",null,{\"className\":\"text-4xl lg:text-5xl font-black text-white mb-3\",\"children\":\"Terms of Service\"}],[\"$\",\"p\",null,{\"className\":\"text-white/40 text-sm\",\"children\":\"Last updated: June 5, 2026\"}]]}],[\"$\",\"main\",null,{\"className\":\"max-w-3xl mx-auto px-4 py-16 legal-prose\",\"children\":[[\"$\",\"p\",null,{\"className\":\"lead text-gray-600\",\"children\":\"These Terms of Service (\\\"Terms\\\") govern your use of Mylobstr.com services. By engaging us to design, build, or host your website, you agree to these Terms. Please read them carefully.\"}],[\"$\",\"h2\",null,{\"children\":\"1. Services\"}],[\"$\",\"p\",null,{\"children\":\"Mylobstr provides website design, development, hosting, and maintenance services for local businesses. The specific deliverables for each project are agreed upon before work begins and may include:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Custom website design and development\"}],[\"$\",\"li\",null,{\"children\":\"Online booking system integration\"}],[\"$\",\"li\",null,{\"children\":\"Contact form and payment integration\"}],[\"$\",\"li\",null,{\"children\":\"SEO setup and Google Search Console submission\"}],[\"$\",\"li\",null,{\"children\":\"Hosting on enterprise-grade infrastructure\"}],[\"$\",\"li\",null,{\"children\":\"Ongoing maintenance, updates, and 24/7 monitoring\"}]]}],[\"$\",\"h2\",null,{\"children\":\"2. Pricing & Payment\"}],[\"$\",\"p\",null,{\"children\":\"Our standard pricing is:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Month 1:\"}],\" $100 one-time build fee (design + development)\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Months 2–3:\"}],\" $40/month (monitoring, fine-tuning, support)\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Month 4 onward:\"}],\" $10/month (hosting + maintenance + support)\"]}]]}],[\"$\",\"p\",null,{\"children\":\"Payments are charged monthly via the payment method on file. Invoices are sent 3 days before each billing date. All prices are in USD. We reserve the right to update pricing with 30 days advance written notice.\"}],[\"$\",\"p\",null,{\"children\":\"Payments not received within 10 days of the due date may result in suspension of services until the balance is settled.\"}],[\"$\",\"h2\",null,{\"children\":\"3. Client Responsibilities\"}],[\"$\",\"p\",null,{\"children\":\"To allow us to deliver your project on time, you agree to:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Provide accurate business information, content, and materials within 5 business days of project kickoff\"}],[\"$\",\"li\",null,{\"children\":\"Respond to review requests within 5 business days\"}],[\"$\",\"li\",null,{\"children\":\"Ensure any content provided (photos, text, logos) does not infringe on third-party intellectual property rights\"}],[\"$\",\"li\",null,{\"children\":\"Maintain payment of the monthly subscription fee to keep your site live\"}]]}],[\"$\",\"p\",null,{\"children\":\"Delays caused by lack of client response may extend the delivery timeline. Mylobstr is not responsible for delays caused by client inaction.\"}],[\"$\",\"h2\",null,{\"children\":\"4. Intellectual Property\"}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Your content:\"}],\" You own all content you provide — logos, photos, text, and business information. You grant Mylobstr a license to use this content solely to build and operate your website.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Your domain:\"}],\" Domain names registered by or transferred to you remain your property at all times.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Website code:\"}],\" The website code, design system, and infrastructure built by Mylobstr remain the intellectual property of Mylobstr and are licensed to you for use during your active subscription. Upon cancellation, we will provide an export of all your content in a portable format.\"]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"]}],\"$L22\"]}],[\"$L23\",\"$L24\"],\"$L25\"]}]\n26:[]\na:\"$W26\"\nb:[\"$\",\"$2\",\"h\",{\"children\":[null,[\"$\",\"$L27\",null,{\"children\":\"$L28\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L29\",null,{\"children\":[\"$\",\"$2a\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L2b\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\nd:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0mjm8rpxa1w1n.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\ne:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/27sconea632l-.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n2c:I[13642,[\"/_next/static/chunks/1el5-48au3iai.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/096_h2ri5bpfm.js\",\"/_next/static/chunks/2rc8erc9vxtob.js\"],\"default\"]\n2d:I[97367,[\"/_next/static/chunks/1el5-48au3iai.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\"],\"OutletBoundary\"]\n10:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Portfolio use:\"}],\" By using our services, you grant Mylobstr the right to display your completed website in our portfolio and marketing materials, unless you request otherwise in writing.\"]}]\n11:[\"$\",\"h2\",null,{\"children\":\"5. Cancellation\"}]\n12:[\"$\",\"p\",null,{\"children\":\"You may cancel your subscription at any time by providing 30 days written notice via email to info@mylobstr.com. Your site will remain live until the end of the 30-day notice period. After cancellation, your site will be taken offline and your content exported and m