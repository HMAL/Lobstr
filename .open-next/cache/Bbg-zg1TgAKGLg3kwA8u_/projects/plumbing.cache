sform:translateX(-40px)\"><img src=\"https://randomuser.me/api/portraits/men/46.jpg\" alt=\"Dave Kowalski\" class=\"w-20 h-20 rounded-full object-cover mx-auto mb-4 ring-2 ring-yellow-400/60\"/><p class=\"font-black text-white text-base mb-0.5\">Dave Kowalski</p><p class=\"text-blue-200 text-sm mb-3\">Master Plumber · 20 yrs</p><p class=\"text-xs text-yellow-400/70 bg-yellow-400/10 rounded-lg px-3 py-1.5 border border-yellow-400/20\">NY State Master License #48291</p></div><div class=\"bg-white/10 border border-white/10 rounded-2xl p-6 text-center cursor-pointer hover:bg-white/15 transition-colors\" style=\"opacity:0;transform:translateY(32px)\"><img src=\"https://randomuser.me/api/portraits/men/67.jpg\" alt=\"Ray Torres\" class=\"w-20 h-20 rounded-full object-cover mx-auto mb-4 ring-2 ring-yellow-400/60\"/><p class=\"font-black text-white text-base mb-0.5\">Ray Torres</p><p class=\"text-blue-200 text-sm mb-3\">Journeyman Plumber · 11 yrs</p><p class=\"text-xs text-yellow-400/70 bg-yellow-400/10 rounded-lg px-3 py-1.5 border border-yellow-400/20\">Capital Region Certified</p></div><div class=\"bg-white/10 border border-white/10 rounded-2xl p-6 text-center cursor-pointer hover:bg-white/15 transition-colors\" style=\"opacity:0;transform:translateX(40px)\"><img src=\"https://randomuser.me/api/portraits/women/34.jpg\" alt=\"Linda Chen\" class=\"w-20 h-20 rounded-full object-cover mx-auto mb-4 ring-2 ring-yellow-400/60\"/><p class=\"font-black text-white text-base mb-0.5\">Linda Chen</p><p class=\"text-blue-200 text-sm mb-3\">Service Technician · 7 yrs</p><p class=\"text-xs text-yellow-400/70 bg-yellow-400/10 rounded-lg px-3 py-1.5 border border-yellow-400/20\">NASSCO Certified Inspector</p></div></div></div></section><section id=\"services\" class=\"py-20 bg-[#010c18]\"><div class=\"max-w-6xl mx-auto px-4\"><div class=\"text-center mb-10\" style=\"opacity:0;transform:translateY(32px)\"><span class=\"inline-block text-xs font-bold uppercase tracking-widest text-blue-400 mb-3\">What We Do</span><h2 class=\"text-4xl font-black text-white mb-2\">What We Fix</h2><p class=\"text-white/40\">Residential and light commercial plumbing.</p></div><div class=\"grid md:grid-cols-3 gap-4\"><div style=\"opacity:0;transform:translateY(32px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer transition-shadow duration-300 p-6 h-full flex flex-col\" style=\"background:radial-gradient(circle at 50% 50%, #3b82f628 0%, transparent 60%), #020e1c;border:1px solid rgba(255,255,255,0.08);box-shadow:none\"><div class=\"text-4xl mb-4 group-hover:scale-110 transition-transform duration-300\">🚿</div><h3 class=\"font-bold text-white mb-2\">Drain Cleaning</h3><p class=\"text-sm text-white/50 leading-relaxed flex-1\">Clogged drains cleared fast — same day service available.</p><div class=\"mt-4 h-px w-8 bg-blue-400/40 group-hover:w-full transition-all duration-500 rounded-full\"></div></div></div><div style=\"opacity:0;transform:translateY(32px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer transition-shadow duration-300 p-6 h-full flex flex-col\" style=\"background:radial-gradient(circle at 50% 50%, #3b82f628 0%, transparent 60%), #020e1c;border:1px solid rgba(255,255,255,0.08);box-shadow:none\"><div class=\"text-4xl mb-4 group-hover:scale-110 transition-transform duration-300\">🚽</div><h3 class=\"font-bold text-white mb-2\">Toilet Repair &amp; Install</h3><p class=\"text-sm text-white/50 leading-relaxed flex-1\">Running toilets, replacements, and new installations.</p><div class=\"mt-4 h-px w-8 bg-blue-400/40 group-hover:w-full transition-all duration-500 rounded-full\"></div></div></div><div style=\"opacity:0;transform:translateY(32px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer transition-shadow duration-300 p-6 h-full flex flex-col\" style=\"background:radial-gradient(circle at 50% 50%, #3b82f628 0%, transparent 60%), #020e1c;border:1px solid rgba(255,255,255,0.08);box-shadow:none\"><div class=\"text-4xl mb-4 group-hover:scale-110 transition-transform duration-300\">🔧</div><h3 class=\"font-bold text-white mb-2\">Pipe Repair &amp; Replacement</h3><p class=\"text-sm text-white/50 leading-relaxed flex-1\">Leaking, burst, or corroded pipes fixed right the first time.</p><div class=\"mt-4 h-px w-8 bg-blue-400/40 group-hover:w-full transition-all duration-500 rounded-full\"></div></div></div><div style=\"opacity:0;transform:translateY(32px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer transition-shadow duration-300 p-6 h-full flex flex-col\" style=\"background:radial-gradient(circle at 50% 50%, #3b82f628 0%, transparent 60%), #020e1c;border:1px solid rgba(255,255,255,0.08);box-shadow:none\"><div class=\"text-4xl mb-4 group-hover:scale-110 transition-transform duration-300\">🌡️</div><h3 class=\"font-bold text-white mb-2\">Water Heater Service</h3><p class=\"text-sm text-white/50 leading-relaxed flex-1\">Repair, flush, or full replacement. Tankless options available.</p><div class=\"mt-4 h-px w-8 bg-blue-400/40 group-hover:w-full transition-all duration-500 rounded-full\"></div></div></div><div style=\"opacity:0;transform:translateY(32px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer transition-shadow duration-300 p-6 h-full flex flex-col\" style=\"background:radial-gradient(circle at 50% 50%, #3b82f628 0%, transparent 60%), #020e1c;border:1px solid rgba(255,255,255,0.08);box-shadow:none\"><div class=\"text-4xl mb-4 group-hover:scale-110 transition-transform duration-300\">🏠</div><h3 class=\"font-bold text-white mb-2\">Bathroom Remodeling</h3><p class=\"text-sm text-white/50 leading-relaxed flex-1\">Full bathroom plumbing for renovations and new builds.</p><div class=\"mt-4 h-px w-8 bg-blue-400/40 group-hover:w-full transition-all duration-500 rounded-full\"></div></div></div><div style=\"opacity:0;transform:translateY(32px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer