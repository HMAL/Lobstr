er border-amber-400/30 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-utensils w-4 h-4 text-amber-400\" aria-hidden=\"true\"><path d=\"M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2\"></path><path d=\"M7 2v20\"></path><path d=\"M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7\"></path></svg></div></div><div class=\"absolute w-96 h-96\"><div class=\"absolute bottom-2 right-0 w-8 h-8 rounded-full bg-amber-500/10 border border-amber-400/20 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 text-amber-300 fill-amber-300/60\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg></div></div></div></div><div class=\"relative z-10 max-w-6xl mx-auto px-4 w-full\"><p class=\"demo-fade-up text-amber-400 text-sm font-bold tracking-widest uppercase mb-3\">Ristorante Italiano · Albany, NY</p><h1 class=\"demo-fade-up demo-fade-up-1 text-6xl lg:text-8xl font-black leading-[0.95] mb-6\">Cucina Italiana<br/><span class=\"text-amber-400\">Autentica.</span></h1><p class=\"demo-fade-up demo-fade-up-2 text-white/70 text-lg max-w-lg mb-8\">Handmade pasta, wood-fired flavors, and recipes passed down through three generations — right here in downtown Albany.</p><div class=\"demo-fade-up demo-fade-up-3 flex gap-3\"><a href=\"#reserve\" class=\"relative group inline-flex items-center gap-2 px-7 py-3.5 bg-amber-500 hover:bg-amber-400 text-black font-black rounded-2xl text-base transition-all hover:scale-105\"><span class=\"absolute -inset-1 -z-10 rounded-[inherit] opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-md glow-hue-bg\"></span>Reserve Online</a><a href=\"tel:+15188880002\" class=\"px-7 py-3.5 bg-white/10 hover:bg-white/20 backdrop-blur text-white font-bold rounded-2xl text-base border border-white/20 transition-all\">(518) 888-0002</a></div></div></section><section id=\"about\" class=\"py-20 bg-[#120a04]\"><div class=\"max-w-6xl mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center\"><div class=\"relative h-80 rounded-3xl overflow-hidden\" style=\"opacity:0;transform:translateX(-40px)\"><img alt=\"Chef cooking\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 50vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D700%26q%3D85&amp;w=3840&amp;q=75\"/></div><div class=\"space-y-4\"><h2 class=\"text-4xl font-black text-amber-400\" style=\"opacity:0;transform:translateY(32px)\">La Nostra Storia</h2><p class=\"text-white/70 leading-relaxed\" style=\"opacity:0;transform:translateY(32px)\">Marco DiSalvo opened Trattoria Albany in 2012 after spending five years cooking in Bologna. The menu reflects his childhood — simple, honest ingredients treated with respect.</p><p class=\"text-white/70 leading-relaxed\" style=\"opacity:0;transform:translateY(32px)\">Every pasta is hand-rolled each morning. Every sauce simmers for hours. We don&#x27;t rush good food. Neither should you.</p><div class=\"grid grid-cols-3 gap-4 pt-4\"><div class=\"text-center bg-amber-900/20 border border-amber-800/30 rounded-2xl p-3\" style=\"opacity:0;transform:scale(0.75)\"><p class=\"text-2xl font-black text-amber-400\">2012</p><p class=\"text-xs text-white/50\">Est.</p></div><div class=\"text-center bg-amber-900/20 border border-amber-800/30 rounded-2xl p-3\" style=\"opacity:0;transform:scale(0.75)\"><p class=\"text-2xl font-black text-amber-400\">4.9★</p><p class=\"text-xs text-white/50\">420+ reviews</p></div><div class=\"text-center bg-amber-900/20 border border-amber-800/30 rounded-2xl p-3\" style=\"opacity:0;transform:scale(0.75)\"><p class=\"text-2xl font-black text-amber-400\">100%</p><p class=\"text-xs text-white/50\">Handmade pasta</p></div></div></div></div></section><section id=\"menu\" class=\"py-20 bg-[#1a0e08]\"><div class=\"max-w-4xl mx-auto px-4\"><div class=\"text-center mb-12\" style=\"opacity:0;transform:translateY(32px)\"><span class=\"inline-block text-xs font-bold uppercase tracking-widest text-amber-600 mb-3\">La Cucina</span><h2 class=\"text-4xl font-black text-amber-400\">Il Menù</h2></div><div class=\"space-y-5\"><div style=\"opacity:0;transform:translateX(-40px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer transition-shadow duration-300 p-6\" style=\"background:radial-gradient(circle at 50% 50%, #f59e0b28 0%, transparent 60%), #1f1006;border:1px solid rgba(255,255,255,0.08);box-shadow:none\"><h3 class=\"text-xs font-black uppercase tracking-widest text-amber-600 mb-5\">Antipasti</h3><div class=\"space-y-5\"><div class=\"flex items-baseline justify-between gap-4 cursor-pointer group/item\"><div><p class=\"font-bold text-white group-hover/item:text-amber-200 transition-colors\">Bruschetta al Pomodoro</p><p class=\"text-sm text-white/50 italic\">Grilled bread, heirloom tomato, fresh basil, EVOO</p></div><p class=\"text-amber-400 font-black shrink-0\">$9</p></div><div class=\"flex items-baseline justify-between gap-4 cursor-pointer group/item\"><div><p class=\"font-bold text-white group-hover/item:text-amber-200 transition-colors\">Burrata</p><p class=\"text-sm text-white/50 italic\">Imported burrata, prosciutto, roasted peppers</p></div><p class=\"text-amber-400 font-black shrink-0\">$14</p></div></div></div></div><div style=\"opacity:0;transform:translateX(40px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer transition-shadow duration-300 p-6\" style=\"background:radial-gradient(circle at 50% 50%, #f59e0b28 0%, transparent 60%), #1f1006;border:1px solid rgba(255,255,255,0.08);box-shadow:none\"><h3 class=\"text-xs font-black uppercase tracking-widest text-amber-600 mb-5\">Pasta</h3><div class=\"space-y-5\"><div class=\"flex items-baseline justify-between gap-4 cursor-pointer group/item\"><div><p class=\"font-bold text-white group-hover/item:text-amber-200 transition-colors\">Tagliatelle al Ragù</p><p class=\"text-sm text-white/50 italic\">Hand-rolled pasta, slow-braised beef &amp; pork ragu</p></div><p class=\"text-amber-400 font-black shrink-0\">$22</p></div><div class=\"flex items-baseline justify-between gap-4 cursor-pointer group/item\"><div><p class=\"font-bold text-white group-hover/item:text-amber-200 transition-colors\">Cacio e Pepe</p><p class=\"text-sm text-white/50 italic\">Tonnarelli, Pecorino Romano, cracked black pepper</p></div><p class=\"text-amber-400 font-black shrink-0\">$19</p></div></div></div></div><div style=\"opacity:0;transform:translateX(-40px)\"><div class=\"group relative overflow-hidden rounded-2xl cursor-pointer transition-shadow duration-300 p-6\" style=\"background:radial-gradient(circle at 50% 50%, #f59e0b28 0%, transparent 60%), #1f1006;border:1px solid rgba(255,255,255,0.08);box-shadow:none\"><h3 class=\"text-xs font-black uppercase tracking-widest text-amber-600 mb-5\">Secondi</h3><div class=\"space-y-5\"><div class=\"flex items-baseline justify-between gap-4 cursor-pointer group/item\"><div><p class=\"font-bold text-white group-hover/item:text-amber-200 transition-colors\">Branzino all&#x27;Acqua Pazza</p><p class=\"text-sm text-white/50 italic\">Mediterranean sea bass, cherry tomato, olives, capers</p></div><p class=\"text-amber-400 font-black shrink-0\">$32</p></div><div class=\"flex items-baseline justify-between gap-4 cursor-pointer group/item\"><div><p class=\"font-bold text-white group-hover/item:text-amber-200 transition-colors\">Bistecca alla Fiorentina</p><p class=\"text-sm text-white/50 italic\">16oz T-bone, rosemary, garlic butter, arugula</p></div><p class=\"text-amber-400 font-black shrink-0\">$48</p></div></div></div></div></div></div></section><section class=\"py-20 overflow-hidden bg-[#120a04]\"><div class=\"max-w-5xl mx-auto px-4\"><div class=\"text-center mb-12\"><div class=\"flex justify-center gap-1 mb-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" cl