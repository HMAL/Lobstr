src=\"/_next/static/chunks/2rc8erc9vxtob.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-FC1Y3Z3VDH\" as=\"script\"/><meta name=\"next-size-adjust\" content=\"\"/><title>Careers — Join the Mylobstr Team | Mylobstr</title><meta name=\"description\" content=\"We&#x27;re a small, growing web design studio in Albany, NY. If you love building things for local businesses, let&#x27;s talk.\"/><meta name=\"keywords\" content=\"local business website design,small business website,restaurant website design,pet clinic website,salon website design,barbershop website,plumber website,gym website design,web design agency Albany NY,affordable web design,website with online booking\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta property=\"og:title\" content=\"Mylobstr — Web Design for Local Businesses\"/><meta property=\"og:description\" content=\"Beautiful, animated websites for local businesses. Pet clinics, restaurants, salons, barbershops, plumbers, and gyms. Launch in 48 hours starting at $100.\"/><meta property=\"og:url\" content=\"https://mylobstr.com\"/><meta property=\"og:site_name\" content=\"Mylobstr\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Mylobstr — Web Design for Local Businesses\"/><meta name=\"twitter:description\" content=\"Beautiful websites for local businesses. Launch in 48 hours starting at $100.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--$?--><template id=\"B:0\"></template><div class=\"min-h-screen flex items-center justify-center bg-white\"><div class=\"flex flex-col items-center gap-4\"><div class=\"w-10 h-10 rounded-full border-2 border-gray-200 border-t-gray-900 animate-spin\"></div><p class=\"text-sm text-gray-400 font-medium\">Loading…</p></div></div><!--/$--><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script src=\"/_next/static/chunks/13o17l5vs-wsr.js\" id=\"_R_\" async=\"\"></script><div hidden id=\"S:0\"><div class=\"min-h-screen bg-white font-sans\"><header class=\"fixed top-0 left-0 right-0 z-50\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex items-center justify-between py-4\"><a href=\"/\" class=\"flex items-center gap-2.5 group shrink-0 bg-gray-900 border-2 border-gray-900 rounded-full px-3 py-1.5 hover:bg-gray-800 transition-colors\"><div class=\"w-7 h-7 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-[14px] h-[14px] text-white\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><div class=\"leading-none\"><span class=\"text-[1rem] font-black tracking-tight text-white\">mylobstr</span><span class=\"text-[1rem] font-black tracking-tight text-blue-400\">.</span><span class=\"text-[1rem] font-black tracking-tight text-white\">com</span></div></a><ul class=\"relative hidden md:flex w-fit rounded-full border-2 border-gray-900 bg-white p-1\"><li class=\"relative z-10 block cursor-pointer\"><a href=\"/our-work\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">Our Work</a></li><li class=\"relative z-10 block cursor-pointer\"><a href=\"/pricing\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">Pricing</a></li><li class=\"relative z-10 block cursor-pointer\"><a href=\"/about\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">About</a></li><li class=\"relative z-10 block cursor-pointer\"><a href=\"/faq\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">FAQ</a></li><li class=\"relative z-10 block cursor-pointer\"><a href=\"/contact\" class=\"block px-3.5 py-2 text-sm font-semibold uppercase text-gray-900 whitespace-nowrap\">Contact</a></li><li class=\"absolute z-0 top-1 bottom-1 rounded-full bg-gray-200\"></li></ul><div class=\"hidden md:flex items-center gap-3 shrink-0\"><a href=\"/contact\" class=\"inline-flex items-center px-4 py-2 bg-white hover:bg-gray-100 text-gray-900 text-sm font-semibold rounded-full transition-all hover:scale-105 shadow-sm border border-gray-200\">Get a Free Quote</a></div><button class=\"md:hidden w-9 h-9 flex items-center justify-center rounded-lg bg-white/20 hover:bg-white/30 backdrop-blur-sm transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu w-4 h-4 text-white\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><section class=\"bg-gray-950 pt-32 pb-16 text-center\"><p class=\"text-blue-400 text-sm font-bold tracking-widest uppercase mb-3\">Careers</p><h1 class=\"text-4xl lg:text-5xl font-black text-white mb-4\">Help local businesses thrive online.</h1><p class=\"text-white/50 text-lg max-w-xl mx-auto\">We&#x27;re a small, fast-moving web studio in Albany, NY. We build beautiful websites for restaurants, salons, gyms, and more — and we&#x27;re looking for people who care about doing great work.</p></section><main class=\"max-w-4xl mx-auto px-4 py-16\"><section class=\"mb-16\"><h2 class=\"text-2xl font-black text-gray-900 mb-8 text-center\">How we work</h2><div class=\"grid sm:grid-cols-2 gap-5\"><div class=\"p-6 rounded-2xl border border-gray-100 bg-gray-50\"><div class=\"text-3xl mb-3\">🏙️</div><h3 class=\"font-bold text-gray-900 mb-1\">Local first</h3><p class=\"text-sm text-gray-500 leading-relaxed\">We serve Albany businesses and we live here too. Community matters to us.</p></div><div class=\"p-6 rounded-2xl border border-gray-100 bg-gray-50\"><div class=\"text-3xl mb-3\">⚡</div><h3 class=\"font-bold text-gray-900 mb-1\">Bias toward action</h3><p class=\"text-sm text-gray-500 leading-relaxed\">We ship fast, learn from real users, and improve continuously.</p></div><div class=\"p-6 rounded-2xl border border-gray-100 bg-gray-50\"><div class=\"text-3xl mb-3\">🤝</div><h3 class=\"font-bold text-gray-900 mb-1\">Honest communication</h3><p class=\"text-sm text-gray-500 leading-relaxed\">No corporate speak. We say what we mean and mean what we say.</p></div><div class=\"p-6 rounded-2xl border border-gray-100 bg-gray-50\"><div class=\"text-3xl mb-3\">🎯</div><h3 class=\"font-bold text-gray-900 mb-1\">Ownership mindset</h3><p class=\"text-sm text-gray-500 leading-relaxed\">Everyone on the team takes full responsibility for their work.</p></div></div></section><section class=\"mb-16\"><h2 class=\"text-2xl font-black text-gray-900 mb-3\">Open positions</h2><p class=\"text-gray-500 mb-8 text-sm\">We&#x27;re a small team and hire slowly — but when we need someone, we find the best person for the role.</p><div class=\"rounded-2xl border border-blue-100 bg-blue-50/40 p-8\"><div class=\"flex items-start justify-between gap-4 flex-wrap\"><div><span class=\"text-xs font-bold text-blue-600 bg-blue-100 px-3 py-1 rounded-full\">Open</span><h3 class=\"text-xl font-black text-gray-900 mt-3 mb-1\">Freelance Web Developer</h3><p class=\"text-gray-500 text-sm mb-4\">Remote · Part-time · Project-based</p><p class=\"text-gray-600 text-sm leading-relaxed max-w-lg\">We&#x27;re looking for a developer comfortable with Next.js, Tailwind CSS, and Framer Motion who wants to help build websites for local businesses. You&#x27;d work directly with our founder on client projects, with flexibility to set your own hours.</p><ul class=\"mt-4 space-y-1.5 text-sm text-gray-500\"><li>✓ Next.js &amp; React experience required</li><li>✓ Tailwind CSS proficiency</li><li>✓ Eye for design and attention to detail</li><li>✓ Reliable communication and deadline ownership</li></ul></div></div><a href=\"mailto:info@mylobstr.com?subject=Freelance Developer Application\" class=\"mt-6 inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-sm transition-all hover:scale-105\">Apply via email →</a></div><div class=\"mt-5 p-6 rounded-2xl border border-gray-100 bg-gray-50 text-center text-sm text-gray-400\">Don&#x27;t see the right role? We always want to hear from talented people. Send your portfolio to<!-- --> <a href=\"mailto:info@mylobstr.com\" class=\"text-blue-600 font-semibold\">info@mylobstr.com</a>.</div></section></main><footer class=\"relative overflow-hidden bg-gray-950 text-white\"><div class=\"absolute top-0 left-0 w-96 h-96 bg-blue-600/5 rounded-full blur-3xl pointer-events-none\"></div><div class=\"absolute bottom-0 right-0 w-72 h-72 bg-indigo-600/5 rounded-full blur-3xl pointer-events-none\"></div><div class=\"border-b border-white/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\"><div class=\"flex flex-col lg:flex-row items-center justify-between gap-6\"><div class=\"text-center lg:text-left\"><h3 class=\"text-2xl font-black mb-1\">Let&#x27;s build something great together.<!-- --> <span class=\"bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent\">Right here in Albany.</span></h3><p class=\"text-white/50 text-sm\">No fancy agency. Just neighbors who know how to build a great website.</p></div><div class=\"flex flex-wrap gap-3 justify-center shrink-0\"><a href=\"/contact\" class=\"px-6 py-3 bg-white text-gray-900 font-bold rounded-xl text-sm hover:bg-gray-100 transition-colors hover:scale-105 transform\">Get a Free Quote →</a><a href=\"mailto:info@mylobstr.com\" class=\"px-6 py-3 bg-white/10 hover:bg-white/20 rounded-xl font-bold text-sm transition-colors flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail w-4 h-4\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg>info@mylobstr.com</a></div></div></div></div><div class=\"relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16\"><div class=\"grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10\"><div class=\"col-span-2 lg:col-span-1 space-y-4\"><a href=\"/\" class=\"flex items-center gap-2\"><div class=\"w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-[18px] h-[18px] text-white\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><span class=\"font-black text-base text-white\">mylobstr<span class=\"text-blue-400\">.</span>com</span></a><p class=\"text-sm text-white/50 leading-relaxed\">Albany Metro&#x27;s neighborhood web studio. For the community, by the community.</p><div class=\"flex items-center gap-2 text-xs font-medium text-white/40\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-3.5 h-3.5 text-blue-400\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Albany, NY Metro Area</div><div class=\"flex items-center gap-1.5 text-xs font-semibold text-emerald-400\"><span class=\"w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse\"></span>Always here — 24/7</div></div><div class=\"space-y-3\"><h4 class=\"text-xs font-black text-white/70 uppercase tracking-wider\">Our Work</h4><ul class=\"space-y-2\"><li><a href=\"/projects/pet\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Happy Paws Vet</a></li><li><a href=\"/projects/restaurant\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Trattoria Albany</a></li><li><a href=\"/projects/salon\" class=\"text-sm text-white/40 hover:text-white transition-colors\">The Cut Collective</a></li><li><a href=\"/projects/barbershop\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Capital Cuts</a></li><li><a href=\"/projects/plumbing\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Albany Pro Plumbing</a></li><li><a href=\"/projects/fitness\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Albany Iron Fitness</a></li></ul></div><div class=\"space-y-3\"><h4 class=\"text-xs font-black text-white/70 uppercase tracking-wider\">Company</h4><ul class=\"space-y-2\"><li><a href=\"/about\" class=\"text-sm text-white/40 hover:text-white transition-colors\">About Us</a></li><li><a href=\"/our-work\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Our Work</a></li><li><a href=\"/pricing\" class=\"text-sm text-white/40 hover:text-white transition-colors\">Pricing</a></li><li><a href=\"/contact\